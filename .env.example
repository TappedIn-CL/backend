# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example should be in git.

# Supabase Postgres connection string
# Get this from Supabase dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# OpenAI API key (used for embeddings + LLM calls)
# Get this from platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Pinecone vector database
# Get API key from pinecone.io dashboard → API Keys
# Index must be created with 1536 dims, cosine metric, serverless
PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX=tappedin-events
