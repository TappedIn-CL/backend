# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example should be in git.
#
# Required for basic API + DB
# Required for JWT routes (/users/me/*, /agent/for-you)
# Required for agent search + scraper enrichment + Pinecone

# -----------------------------------------------------------------------------
# Database (required)
# Supabase → Settings → Database → Connection string (URI)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Auth — JWT verification (required for authenticated routes)
# Same project as frontend VITE_SUPABASE_* (URL without /v1)
# Supabase → Settings → API → Project URL + anon public key
# -----------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_ANON_KEY=eyJ-your-anon-key

# -----------------------------------------------------------------------------
# OpenAI (required for /agent/query, /agent/for-you, ingestion, some scrapers)
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here

# -----------------------------------------------------------------------------
# Pinecone (required for agent vector search)
# Index: 1536 dimensions, cosine metric, serverless
# https://app.pinecone.io/
# -----------------------------------------------------------------------------
PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX=tappedin-events

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Geocoding when creating events (POST /events) — backend/app/utils/geocoding.py
# GOOGLE_MAPS_API_KEY=

# Agent graph calling back to this API (default: http://localhost:8000)
# BACKEND_URL=http://localhost:8000
